	/// =1 cho 13 tháng gần nhất trong phạm vi lọc (dùng làm filter cho biểu đồ xu hướng)
	measure 'Hiển thị 13 tháng' =
			VAR _last = CALCULATE ( MAX ( DimDate[Ngày] ), ALLSELECTED ( DimDate ) )
			VAR _cur = MAX ( DimDate[Ngày] )
			RETURN
			    IF ( _cur > EOMONTH ( _last, -13 ) && _cur <= EOMONTH ( _last, 0 ), 1, 0 )
		formatString: 0
		displayFolder: 0. Chung
		lineageTag: d047bbb6-c040-49fa-ba14-ddf1be0b55c9

	measure 'Hiển thị 18 tháng' =
			VAR _last = CALCULATE ( MAX ( DimDate[Ngày] ), ALLSELECTED ( DimDate ) )
			VAR _cur = MAX ( DimDate[Ngày] )
			RETURN
			    IF ( _cur > EOMONTH ( _last, -18 ) && _cur <= EOMONTH ( _last, 0 ), 1, 0 )
		formatString: 0
		displayFolder: 0. Chung
		lineageTag: 64601fa6-4e96-4177-98e0-f943d5a66309

	measure 'Khách hàng mới YTD' =
			VAR _m = MAX ( FactKPI[month_end] )
			RETURN
			    CALCULATE ( [Khách hàng mới], REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Ngày], DATE ( YEAR ( _m ), 1, 1 ), _m ) )
		formatString: #,##0 "KH"
		displayFolder: 3. Khách hàng, thẻ & kênh
		lineageTag: dc5369b0-284e-41f5-81f9-ef323d377540

	measure 'Kế hoạch KH mới YTD' =
			VAR _m = MAX ( FactKPI[month_end] )
			RETURN
			    CALCULATE ( [Kế hoạch khách hàng mới], REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Ngày], DATE ( YEAR ( _m ), 1, 1 ), _m ) )
		formatString: #,##0 "KH"
		displayFolder: 3. Khách hàng, thẻ & kênh
		lineageTag: 874010f9-194b-4423-af34-2baae42d6bb9

